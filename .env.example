# Copy to .env and fill in. apps/api validates every one of these at startup and
# refuses to boot if any is missing or malformed — see apps/api/src/config/env.ts.

NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5180

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://dsg:dsg@localhost:5433/dsg

# Signs access-token JWTs. Any random 32+ char string: `openssl rand -base64 32`
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Add the redirect URI below to "Authorized redirect URIs".
# Setup walkthrough: docs/auth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Mounts POST /api/auth/test-login, which mints a session without Google. Used by the
# Playwright suite. The server refuses to start if this is true while NODE_ENV=production.
AUTH_TEST_LOGIN_ENABLED=false
